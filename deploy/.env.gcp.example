# Copy to deploy/.env on the VM (never commit .env).
#
#   cp deploy/.env.gcp.example deploy/.env

# ---------- domain / TLS (A-record must point at the VM external IP) ----------
DOMAIN=gcp.graharekha.co.in
ACME_EMAIL=admin@graharekha.co.in

# ---------- secrets ----------
# openssl rand -hex 32
APP_SECRET=CHANGE_ME
PG_PASSWORD=CHANGE_ME
PG_USER=astro
PG_DB=astro

# ---------- Google Sign-In (same Web client as Railway) ----------
GOOGLE_CLIENT_ID=424015602169-sh7vtf9gita53b7s6jkiqr20vms8aevl.apps.googleusercontent.com

# ---------- payments ----------
PAYMENT_GATEWAY=razorpay
RAZORPAY_PAYMENT_BUTTON_ID=pl_TMzAWfueT93HPY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYEE_NAME=GrahaRekha

# ---------- prices (paise) — match fixed Razorpay button ₹298 ----------
PRICE_PALM=29800
PRICE_REPORT=29800
PRICE_HORARY=29800
PRICE_TIMING=29800
PRICE_MATCH=29800
PRICE_MUHURAT=29800
PRICE_BTR=29800
PRICE_SUB=29800
PRICE_NUMEROLOGY=29800
PRICE_BUNDLE=29800
SUB_HORARY=3

# ---------- capacity (one VM) ----------
INLINE_WORKER_THREADS=2
CAP_FULL_REPORT=1
CAP_BTR=1
CAP_PALM=2
CAP_DEFAULT=4

# ---------- image source (Dockerfile.worker clones this) ----------
GIT_REPO=https://github.com/ritesh1sinha-cyber/astro-palmistry.git
GIT_REF=main

# Guest/admin login for go-live testing. Set to 0 when Google alone is enough.
DEV_LOGIN=1
ENV=prod
