# Copy to deploy/.env on the VM (never commit .env).
#
#   cp deploy/.env.gcp.example deploy/.env

# ---------- domain / TLS (A-record must point at the VM external IP) ----------
# Caddyfile.gcp serves www + gcp + apex→www. DOMAIN is used by health/docs only.
DOMAIN=www.graharekha.com
ACME_EMAIL=admin@graharekha.com
ALLOWED_ORIGINS=https://www.graharekha.com,https://graharekha.com,https://gcp.graharekha.com

# ---------- secrets ----------
# openssl rand -hex 32
APP_SECRET=CHANGE_ME
PG_PASSWORD=CHANGE_ME
PG_USER=astro
PG_DB=astro

# ---------- Google Sign-In (same Web client as Railway) ----------
GOOGLE_CLIENT_ID=424015602169-sh7vtf9gita53b7s6jkiqr20vms8aevl.apps.googleusercontent.com

# ---------- guest / admin (copy from Railway if you use them) ----------
GUEST_PASSCODE=
# ADMIN_USER / ADMIN_PASS live in /.config or AUTH_CONFIG JSON on the image;
# for a VM you can also set them here if your deploy reads them from env.

# ---------- payments ----------
PAYMENT_GATEWAY=razorpay
RAZORPAY_PAYMENT_BUTTON_ID=pl_TMzAWfueT93HPY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYEE_NAME=GrahaRekha

# ---------- prices (paise) — match fixed Razorpay button ₹298 ----------
PRICE_PALM=29800
PRICE_REPORT=29800
PRICE_HORARY=29800
PRICE_TIMING=29800
PRICE_MATCH=29800
PRICE_MUHURAT=29800
PRICE_BTR=29800
PRICE_SUB=29800
PRICE_NUMEROLOGY=29800
PRICE_BUNDLE=29800
SUB_HORARY=3
FREE_DAILY=3
SUB_DAILY_GEN=3

# ---------- LLM prose + paid follow-up chat (copy from Railway) ----------
# Without these, /api/public-config reports chatEnabled=false and the site
# hides the chat panel. LLM_BASE_URL must be https.
LLM_ENABLED=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_TABS=full_report,user_question,horary,palm,chat,summary
LLM_TIMEOUT=90
LLM_CONCURRENCY=2
LLM_CACHE_TTL=3600

# ---------- capacity (one VM) ----------
INLINE_WORKER_THREADS=2
CAP_FULL_REPORT=1
CAP_BTR=1
CAP_PALM=2
CAP_DEFAULT=4

# ---------- image source (deploy/Dockerfile clones this) ----------
GIT_REPO=https://github.com/ritesh1sinha-cyber/astro-palmistry.git
GIT_REF=main

# Guest/admin login for go-live testing. Set to 0 when Google alone is enough.
DEV_LOGIN=1
ENV=prod

# ---------- contact-form email alerts ----------
# When someone submits "Request a session", the API saves to Postgres and
# emails ENQUIRY_NOTIFY_TO.
#
# GoDaddy Professional Email (Titan) — use either host (both work for GoDaddy):
#   smtpout.secureserver.net   ← GoDaddy's documented SMTP for Titan mailboxes
#   smtp.titan.email           ← Titan direct (465 SSL or 587 STARTTLS)
#
# Recommended for this app (matches core/mail.py port 465 → SSL):
#   SMTP_HOST=smtpout.secureserver.net
#   SMTP_PORT=465
#   SMTP_USER=admin@graharekha.com
#   SMTP_PASSWORD=your-titan-mailbox-password
#   SMTP_FROM=admin@graharekha.com
#   ENQUIRY_NOTIFY_TO=admin@graharekha.com
#
# Alternative (587 + STARTTLS): SMTP_HOST=smtp.titan.email SMTP_PORT=587 SMTP_USE_TLS=1
#
# Leave SMTP_HOST blank to store enquiries only (view under Admin → Analysis).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
ENQUIRY_NOTIFY_TO=admin@graharekha.com
