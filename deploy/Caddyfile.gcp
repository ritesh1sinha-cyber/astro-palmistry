{
	email {$ACME_EMAIL}
}

# Production site + API (no Vercel). gcp kept so rollback subdomain still works.
www.graharekha.com, gcp.graharekha.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/payment/webhook {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /health {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
		# App WebView loads BASE_URL "/" not "/index.html"; without no-cache here
		# Android keeps an old index.html on disk even after force-stop.
		header / Cache-Control "no-cache, must-revalidate"
		header /index.html Cache-Control "no-cache, must-revalidate"
	}
}

# Apex → www
graharekha.com {
	redir https://www.graharekha.com{uri} permanent
}
