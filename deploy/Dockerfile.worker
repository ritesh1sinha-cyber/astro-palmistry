# Worker / all-in-one image — carries both engines.
#
# Railway and Render both run this single image with INLINE_WORKER=1, so one
# service answers HTTP and runs the readings. On a VM, docker-compose runs the
# same image as separate api / worker-heavy / worker-light services.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---------------------------------------------------------------------------
# One COPY of the whole context, deliberately.
#
# Every build that used a path-specific COPY eventually failed on Railway:
# deploy/ephe/, deploy/entrypoint.sh, engines/astro, and even a bare file —
# requirements.worker.txt arrived "not found" while requirements.api.txt, its
# sibling in the same directory, made it. Stop depending on individual paths:
# copy everything and let .dockerignore decide what to leave out.
#
# Trade-off: requirements install from the same context, so there is no layer
# caching for a pure-requirements change. Correctness beats caching.
# ---------------------------------------------------------------------------
COPY . .

# fail loudly and specifically if the context was incomplete — before spending
# minutes installing wheels from files that may have failed to arrive
RUN python -c "import pathlib,sys; \
missing=[q for q in ('requirements.api.txt','requirements.worker.txt','engines/palm_api/pipeline.py','engines/astro/astro_precompute.py','core/handlers.py','api.py') if not pathlib.Path(q).exists()]; \
sys.exit('BUILD CONTEXT INCOMPLETE - absent from image: '+', '.join(missing)) if missing else print('build context complete')"

RUN pip install -r requirements.worker.txt

# sentence-transformers + torch (~2 GB) are needed ONLY by the full confluence
# report. Off by default so the first deploy is quick; turn it on when you have
# a box with 4 GB and want that one feature.
ARG WITH_CONFLUENCE=0
RUN if [ "$WITH_CONFLUENCE" = "1" ]; then \
      pip install "torch==2.4.*" --index-url https://download.pytorch.org/whl/cpu && \
      pip install "sentence-transformers>=2.2"; \
    fi

# `import palm_api` and `import astro_precompute` both resolve, with the engines
# left exactly where the repo puts them.
ENV PYTHONPATH=/app:/app/engines:/app/engines/astro

# warm the rule corpora into the image so the first customer isn't the one who waits
RUN python -c "from palm_api.pipeline import ensure_corpus; ensure_corpus()" || true

# fail the BUILD, not the first customer, if the astrology engine can't import
RUN PYJHORA_SRC=/usr/local/lib/python3.12/site-packages python -c "\
import astro_precompute, vedic_confluence_report, numerology_report, \
       kundali_match, muhurat_checker, btr_rectify, astro_voice, astro_split; \
print('astrology engine imports OK')"

# natal_from_pyjhora._ensure_pyjhora() looks for the PyJHora SOURCE tree and
# raises FileNotFoundError without it. pip installs `jhora/` straight into
# site-packages, so that directory is the source root.
ENV PYJHORA_SRC=/usr/local/lib/python3.12/site-packages

ENV INLINE_WORKER=1 INLINE_WORKER_THREADS=2 \
    WORKER_GROUPS=heavy,palm,light ASTRO_HOTFIX=1 \
    LOCAL_STORE=/data/storage

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "import os,urllib.request;urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8080')+'/health')"

# The entrypoint is written inline rather than COPYed. Railway did not provide
# deploy/ in the build context (the directory holding this Dockerfile), and a
# build should not depend on how a platform resolves that.
#
# It installs Swiss Ephemeris data at boot when EPHE_PATH points at a directory
# holding *.se1 — e.g. a mounted volume. Without it swisseph uses its built-in
# model: accurate to a fraction of a degree, just not bit-identical to JHora.
RUN printf '%s\n' \
  '#!/bin/sh' \
  'set -e' \
  'DEST="/usr/local/lib/python3.12/site-packages/jhora/data/ephe"' \
  'if [ -n "$EPHE_PATH" ] && ls "$EPHE_PATH"/*.se1 >/dev/null 2>&1; then' \
  '  mkdir -p "$DEST"' \
  '  cp "$EPHE_PATH"/*.se1 "$DEST"/' \
  '  echo "[entrypoint] installed $(ls "$EPHE_PATH"/*.se1 | wc -l) ephemeris files"' \
  'else' \
  '  echo "[entrypoint] no ephemeris data (set EPHE_PATH for JHora-exact positions)"' \
  'fi' \
  'exec "$@"' \
  > /entrypoint.sh && chmod +x /entrypoint.sh && sh -n /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["sh", "-c", "uvicorn api:app --host 0.0.0.0 --port ${PORT:-8080}"]
