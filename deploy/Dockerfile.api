# API image — stateless, no astrology/CV engines, so it stays small and boots fast.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
        libffi-dev shared-mime-info fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      "fastapi[standard]==0.115.*" "uvicorn[standard]==0.32.*" \
      "sqlalchemy==2.0.*" "psycopg[binary]==3.2.*" "redis==5.2.*" \
      "pydantic==2.9.*" "google-auth==2.35.*" "boto3==1.35.*" \
      "weasyprint==62.*" "pydyf==0.11.0"

COPY core ./core
COPY api.py ./
COPY worker.py ./

ENV INLINE_WORKER=0
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=4s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8080/health')"

# 2 uvicorn workers per replica: the API is I/O-bound, the engines live elsewhere
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
