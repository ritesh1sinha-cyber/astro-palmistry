# ---------- domain / TLS ----------
DOMAIN=astropalmistry.in
ACME_EMAIL=ops@astropalmistry.in

# ---------- secrets (generate; never reuse) ----------
# openssl rand -hex 32
APP_SECRET=
PG_PASSWORD=
PG_USER=astro
PG_DB=astro

# ---------- Google Sign-In ----------
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ---------- payments (Razorpay) ----------
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# UPI intent fallback for pre-gateway testing only — it cannot be verified
UPI_ID=
PAYEE_NAME=Astro Palmistry

# ---------- prices (paise) ----------
PRICE_PALM=49900
PRICE_REPORT=149900
PRICE_HORARY=9900
PRICE_TIMING=19900
PRICE_MATCH=29900
PRICE_MUHURAT=4900
PRICE_BTR=99900
PRICE_SUB=19900
FREE_DAILY=3
SUB_HORARY=3

# ---------- capacity ----------
CAP_FULL_REPORT=4
CAP_BTR=2
CAP_PALM=6
CAP_DEFAULT=12
RATE_PER_MIN=60
MAX_QUEUE_DEPTH=5000

# ---------- object storage (leave blank to use the local volume) ----------
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- retention ----------
REPORT_RETENTION_DAYS=365
JOB_RETENTION_DAYS=90
KEEP_UPLOADS=0

# ---------- optional narrative polish ----------
# ASTRO_LLM_KEY=
# ASTRO_LLM_MODEL=gpt-4o-mini

# ---------- NEVER set in production ----------
# DEV_LOGIN=1
# INLINE_WORKER=1
