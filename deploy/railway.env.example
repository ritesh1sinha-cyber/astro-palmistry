# Railway single-service deploy — paste into astro-api Variables
# (see RAILWAY.md "Memory and cost" for why these values)

ENV=prod
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

APP_SECRET=
INLINE_WORKER=1
INLINE_WORKER_THREADS=1

CAP_FULL_REPORT=1
CAP_BTR=1
CAP_PALM=1
CAP_DEFAULT=1   # all other kinds (horary, daily, …) — one at a time total per box

ALLOWED_ORIGINS=https://www.graharekha.co.in
LOCAL_STORE=/data/storage

# Scale (Settings → Scale): Memory 6 GB, CPU 2–4 vCPU
# Volume mount: /data

# Keep WITH_CONFLUENCE=1 in railway.json build (default) for full report quality.
# Do not set WITH_CONFLUENCE=0 unless you accept degraded_lexical mode.
