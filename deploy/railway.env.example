# Railway single-service deploy — paste into astro-api Variables
# (see RAILWAY.md "Memory and cost" for why these values)

ENV=prod
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

APP_SECRET=
INLINE_WORKER=1
INLINE_WORKER_THREADS=1

CAP_FULL_REPORT=1
CAP_BTR=1
CAP_PALM=1
CAP_DEFAULT=1   # all other kinds (horary, daily, …) — one at a time total per box

ALLOWED_ORIGINS=https://www.graharekha.co.in
LOCAL_STORE=/data/storage

# LLM prose layer + paid follow-up chat (off unless all three are set).
# Without these, /api/public-config reports chatEnabled=false and the site
# hides the chat panel. LLM_TABS is per kind: use LLM_TABS=chat to answer
# follow-ups while the reports themselves stay on the deterministic templates.
# LLM_BASE_URL must be https — the key and the customer's birth details travel
# over it. Never point it at a host that is not meant to be reachable.
LLM_ENABLED=1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_TABS=full_report,user_question,horary,palm,chat

# Scale (Settings → Scale): Memory 6 GB, CPU 2–4 vCPU
# Volume mount: /data

# Keep WITH_CONFLUENCE=1 in railway.json build (default) for full report quality.
# Do not set WITH_CONFLUENCE=0 unless you accept degraded_lexical mode.
