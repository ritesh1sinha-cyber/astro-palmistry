{
	email {$ACME_EMAIL}
	servers { protocols h1 h2 h3 }
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# webhooks: no rate limit, and the raw body must reach the app untouched
	handle /api/payment/webhook {
		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080 {
			lb_policy least_conn
			health_uri /health
			health_interval 10s
			transport http { read_timeout 120s }
		}
	}

	handle /health {
		reverse_proxy api:8080
	}

	# the site — same origin as the API, so CORS never enters the picture
	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
		header / Cache-Control "no-cache, must-revalidate"
		header /index.html Cache-Control "no-cache, must-revalidate"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}
}
