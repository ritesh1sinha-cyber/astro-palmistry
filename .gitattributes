# Git LFS — MiniLM / cross-encoder weights exceed GitHub's 100 MB file limit
# Without LFS, `git push` rejects model.safetensors (~450 MB).
engines/astro/models/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
engines/astro/models/**/*.bin filter=lfs diff=lfs merge=lfs -text
engines/astro/models/**/pytorch_model.bin filter=lfs diff=lfs merge=lfs -text
engines/astro/models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
engines/astro/models/**/sentencepiece.bpe.model filter=lfs diff=lfs merge=lfs -text
engines/astro/models/**/unigram.json filter=lfs diff=lfs merge=lfs -text
engines/astro/models/**/tokenizer.json filter=lfs diff=lfs merge=lfs -text
