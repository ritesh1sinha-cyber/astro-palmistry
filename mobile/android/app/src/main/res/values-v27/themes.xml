<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Oreo MR1 the navigation bar can carry dark icons, so it can be paper
         like the rest of the page instead of a dark strip. -->
    <style name="Theme.GrahaRekha" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryDark">@color/paper</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
